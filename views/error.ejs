<!-- //エラーを実際に出す画面 -->
<% layout('layouts/boilerplate') %>
<div class="row">
    <div class="offset-3 col-6">
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading"><%= err.message %></h4>
            <% if (process.env.NODE_ENV !== 'production') { %> 
                <!-- 本番環境じゃない時だけエラー表示 -->
            <p><%= err.stack %></p>
            <% } %>
        </div>
    </div>
</div>